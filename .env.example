# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Symmetric key for SSN encryption (pgcrypto). Generate with: openssl rand -base64 32
SSN_ENCRYPTION_KEY=CHANGE-ME

# Bearer token protecting /api/cron/* routes. Generate with: openssl rand -hex 32
# On Vercel, setting CRON_SECRET makes Vercel Cron send it automatically.
CRON_SECRET=CHANGE-ME
